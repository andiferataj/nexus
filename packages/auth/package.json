  },
  "dependencies": {
    "@nexus/contracts": "workspace:*",
    "@nexus/core": "workspace:*"
  },
  "devDependencies": {
    "@nexus/typescript-config": "workspace:*",
    "@types/node": "^24.0.0"
  }
}
