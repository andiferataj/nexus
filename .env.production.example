# Prefer `pnpm setup:production your-domain.com` to generate fresh secrets.
DOMAIN=your-domain.com
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
AUTH_SECRET=replace-with-a-random-secret-of-at-least-48-characters

# Both fields are required to enable password reset email.
RESEND_API_KEY=
MAIL_FROM=

# All three fields are required to enable optional subscription billing.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_REQUIRED=false
