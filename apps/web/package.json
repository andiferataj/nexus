{
  "name": "@nexus/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "clean": "node -e \"for (const path of ['.next', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@nexus/auth": "workspace:*",
    "@nexus/contracts": "workspace:*",
    "@nexus/core": "workspace:*",
    "@nexus/database": "workspace:*",
    "@nexus/shared": "workspace:*",
    "next": "^16.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "next-auth": "beta",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@nexus/typescript-config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
